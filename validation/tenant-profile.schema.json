{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MikkelsenBrenno/AllPowershellVibes/validation/tenant-profile.schema.json",
  "title": "Intune Script Library tenant validation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "Packages"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "SchemaVersion": {
      "const": "1.0"
    },
    "Packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "literal": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        }
      ]
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Script",
        "Variable",
        "Equals"
      ],
      "properties": {
        "Script": {
          "type": "string",
          "pattern": "^[^/\\\\]+\\.ps1$"
        },
        "Variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_:]*$"
        },
        "Equals": {
          "$ref": "#/$defs/literal"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Path",
        "AllowedStatuses",
        "ExpectedContext"
      ],
      "properties": {
        "Path": {
          "type": "string",
          "pattern": "^(Detection-Remediation|Custom-Compliance|Intune-Platform-Scripts|Win32-Packaged-Scripts)/[^/]+/[^/]+$"
        },
        "AllowedStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Template",
              "Planned",
              "Example",
              "NeedsReview",
              "PilotReady",
              "Validated"
            ]
          }
        },
        "ExpectedContext": {
          "type": "string",
          "minLength": 1
        },
        "ConfigurationAssertions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assertion"
          }
        }
      }
    }
  }
}
